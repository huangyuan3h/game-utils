class_name DataTableLoader
extends RefCounted
## Loads normalized JSON data tables generated by `gu data build` for runtime lookup.


static func load_table(path: String) -> Array[Dictionary]:
	var rows: Array[Dictionary] = []
	if path == "" or not FileAccess.file_exists(path):
		return rows

	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		return rows
	var text := f.get_as_text()
	f.close()

	var parsed: Variant = JSON.parse_string(text)
	var raw_rows: Array = []
	if parsed is Array:
		raw_rows = parsed as Array
	elif parsed is Dictionary:
		var doc := parsed as Dictionary
		if doc.get("rows") is Array:
			raw_rows = doc["rows"] as Array

	for item in raw_rows:
		if item is Dictionary:
			rows.append((item as Dictionary).duplicate(true))
	return rows


static func index_by_id(rows: Array[Dictionary], id_key: String = "id") -> Dictionary:
	var out: Dictionary = {}
	for row in rows:
		if row.has(id_key):
			var key := str(row[id_key])
			if key != "":
				out[key] = row
	return out


static func find_by_id(rows: Array[Dictionary], target_id: String, id_key: String = "id") -> Dictionary:
	for row in rows:
		if row.has(id_key) and str(row[id_key]) == target_id:
			return row
	return {}
