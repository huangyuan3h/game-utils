extends StaticBody3D
## Renders MapData generated by MapGenerator.
## Ground mesh stays here; sea, lake, river, and prop meshes are built via TerrainBuildContext.

signal generation_finished(data: MapData)

const MapGen = preload("res://scripts/map_generator.gd")
const WorldLocatorScript = preload("res://scripts/map/world_locator.gd")
const SeaMesh = preload("res://scripts/terrain/sea_mesh.gd")
const LakeMesh = preload("res://scripts/terrain/lake_mesh.gd")
const RiverMesh = preload("res://scripts/terrain/river_mesh.gd")
const LandPropsMesh = preload("res://scripts/terrain/land_props_mesh.gd")

@onready var _mesh_instance: MeshInstance3D = $Mesh
@onready var _collision: CollisionShape3D = $Collision
@onready var _water: MeshInstance3D = $Water
@onready var _rivers_mesh: MeshInstance3D = $Rivers
@onready var _lakes_mesh: MeshInstance3D = $Lakes
@onready var _props_root: Node3D = $Props

var seed_value: int = 42
var _data: MapData
var _ctx: TerrainBuildContext
var _spawn_point: Vector3 = Vector3.ZERO
var _poi_spots: Array[Dictionary] = []
var _ground_mat: ShaderMaterial
var _last_weather: Dictionary = {}
var _async_task_id: int = -1
var _async_result: MapData = null
var _async_mutex := Mutex.new()


func _ready() -> void:
	collision_layer = 0
	collision_mask = 0
	if _rivers_mesh == null:
		_rivers_mesh = MeshInstance3D.new()
		_rivers_mesh.name = "Rivers"
		add_child(_rivers_mesh)
	if _lakes_mesh == null:
		_lakes_mesh = MeshInstance3D.new()
		_lakes_mesh.name = "Lakes"
		add_child(_lakes_mesh)
	if _props_root == null:
		_props_root = Node3D.new()
		_props_root.name = "Props"
		add_child(_props_root)
	generate_random(seed_value)


func _process(_delta: float) -> void:
	if _async_task_id < 0:
		return
	if not WorkerThreadPool.is_task_completed(_async_task_id):
		return
	WorkerThreadPool.wait_for_task_completion(_async_task_id)
	_async_task_id = -1
	_async_mutex.lock()
	var data := _async_result
	_async_result = null
	_async_mutex.unlock()
	if data != null:
		_apply_map_data(data)
		generation_finished.emit(data)


func _exit_tree() -> void:
	if _async_task_id >= 0:
		WorkerThreadPool.wait_for_task_completion(_async_task_id)
		_async_task_id = -1


## --- Public API -----------------------------------------------------------

func generate_random(p_seed: int = -1, opts: Dictionary = {}) -> MapData:
	var data: MapData = MapGen.generate_random(p_seed, opts)
	_apply_map_data(data)
	generation_finished.emit(data)
	return data


func generate_random_async(p_seed: int = -1, opts: Dictionary = {}) -> void:
	if _async_task_id >= 0:
		return
	var resolved_seed: int = p_seed if p_seed >= 0 else int(Time.get_ticks_usec()) ^ randi()
	var opts_copy := opts.duplicate(true)
	_async_task_id = WorkerThreadPool.add_task(func() -> void:
		var generated: MapData = MapGen.generate(resolved_seed, opts_copy)
		_async_mutex.lock()
		_async_result = generated
		_async_mutex.unlock()
	)


func is_generating_async() -> bool:
	return _async_task_id >= 0


func rebuild(p_seed: int = 42, opts: Dictionary = {}) -> void:
	generate_random(p_seed, opts)


func get_map_data() -> MapData:
	return _data


func get_spawn_point() -> Vector3:
	return _spawn_point


func get_poi_spots() -> Array[Dictionary]:
	return _poi_spots.duplicate(true)


func get_map_size() -> float:
	return _data.size if _data != null else MapGen.DEFAULT_SIZE


func sample_height(x: float, z: float) -> float:
	return _data.sample_height(x, z) if _data != null else 0.0


func sample_biome(x: float, z: float) -> int:
	return _data.sample_biome(x, z) if _data != null else MapGen.Biome.GRASS


func sample_water_surface(x: float, z: float) -> float:
	return _data.sample_water_surface(x, z) if _data != null else -INF


func nearest_water_distance(x: float, z: float) -> float:
	return _data.nearest_water_distance(x, z) if _data != null else INF


func biome_name_at(x: float, z: float) -> String:
	return _data.biome_name_at(x, z) if _data != null else "?"


func landform_name() -> String:
	return _data.landform_name() if _data != null else "?"


func sample_slope(x: float, z: float) -> float:
	return _data.sample_slope(x, z) if _data != null else 0.0


func apply_weather(params: Dictionary) -> void:
	_last_weather = params.duplicate()
	var wetness := float(params.get("ground_wetness", 0.0))
	var rain := float(params.get("rain_intensity", 0.0))
	var snow := float(params.get("snow_cover", 0.0))
	var wind := float(params.get("wind_strength", 0.14))
	var cloud_dark := float(params.get("cloud_darkness", 0.0))
	var wind_v: Vector3 = params.get("wind_vector", Vector3(1.0, 0.0, 0.3))
	var wind_xz := Vector2(wind_v.x, wind_v.z)
	if wind_xz.length_squared() > 0.0001:
		wind_xz = wind_xz.normalized()
	else:
		wind_xz = Vector2(0.95, 0.31)

	if _ground_mat != null:
		_ground_mat.set_shader_parameter("wetness", wetness)
		_ground_mat.set_shader_parameter("rain_intensity", rain)
		_ground_mat.set_shader_parameter("snow_cover", snow)

	for mesh_node in [_water, _lakes_mesh, _rivers_mesh]:
		if mesh_node != null and mesh_node.material_override is ShaderMaterial:
			var sm := mesh_node.material_override as ShaderMaterial
			sm.set_shader_parameter("rain_intensity", rain)
			sm.set_shader_parameter("wind_strength", wind)
			sm.set_shader_parameter("cloud_darkness", cloud_dark)

	if _props_root != null:
		for ch in _props_root.get_children():
			if ch is MeshInstance3D or ch is MultiMeshInstance3D:
				var mat: Material = ch.material_override
				if mat is ShaderMaterial:
					var fsm := mat as ShaderMaterial
					fsm.set_shader_parameter("wind_strength", wind)
					fsm.set_shader_parameter("wind_dir", wind_xz)
					fsm.set_shader_parameter("snow_cover", snow)
					fsm.set_shader_parameter("wetness", wetness)


## --- Internals ------------------------------------------------------------

func _apply_map_data(data: MapData) -> void:
	if data == null or not data.is_valid():
		push_warning("TerrainMap received invalid MapData.")
		return
	_data = data
	seed_value = data.seed_value
	if _collision != null:
		_collision.shape = null

	var ctx := TerrainBuildContext.new(data)
	_ctx = ctx

	# 1) Build river mesh first (seats channels into data heights/biomes & extracts mouths)
	var river_builder := RiverMesh.new()
	var river_res: Dictionary = river_builder.build(ctx)
	ctx.mouths = river_res.get("mouths", []) as Array[Dictionary]
	if _rivers_mesh != null:
		_rivers_mesh.mesh = river_res.get("mesh", null) as Mesh
		_rivers_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF

	# 2) Refresh height bounds, locate spawn + POI clear spots, and bake lookup textures
	data.refresh_height_range()
	_spawn_point = WorldLocatorScript.find_spawn_point(data)
	_poi_spots = WorldLocatorScript.find_poi_spots(data, 6, 16.0, _spawn_point)
	ctx.clear_spots.clear()
	ctx.clear_spots.append(Vector2(_spawn_point.x, _spawn_point.z))
	for spot: Dictionary in _poi_spots:
		var sp: Vector3 = spot["position"] as Vector3
		ctx.clear_spots.append(Vector2(sp.x, sp.z))
	ctx.height_tex = _make_height_texture(data)
	ctx.field_tex = _make_field_texture(data)

	# 3) Build ground, sea, lakes, river shader, and land props from context
	_build_ground_mesh(ctx)
	_build_sea(ctx)
	_build_lakes(ctx)
	if _rivers_mesh != null:
		_rivers_mesh.material_override = river_builder.create_material(ctx)
	LandPropsMesh.new().build(ctx, _props_root)

	if not _last_weather.is_empty():
		apply_weather(_last_weather)


func _surface_weights(b: int) -> Color:
	## 4-way continuous weights for terrain_ground.gdshader: (sand, veg, dirt, rock)
	match b:
		MapGen.Biome.SEA:
			return Color(0.85, 0.0, 0.10, 0.05)
		MapGen.Biome.LAKE:
			return Color(0.60, 0.0, 0.25, 0.15)
		MapGen.Biome.RIVER:
			return Color(0.45, 0.0, 0.35, 0.20)
		MapGen.Biome.SAND:
			return Color(1.0, 0.0, 0.0, 0.0)
		MapGen.Biome.DIRT:
			return Color(0.05, 0.10, 0.80, 0.05)
		MapGen.Biome.GRASS, MapGen.Biome.MEADOW, MapGen.Biome.FOREST:
			return Color(0.0, 1.0, 0.0, 0.0)
		MapGen.Biome.MOUNTAIN:
			return Color(0.0, 0.08, 0.12, 0.80)
		MapGen.Biome.CLIFF, MapGen.Biome.ALPINE:
			return Color(0.0, 0.0, 0.0, 1.0)
		_:
			return Color(0.0, 1.0, 0.0, 0.0)


func _build_ground_mesh(ctx: TerrainBuildContext) -> void:
	var data := ctx.data
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var half := data.size * 0.5
	var step := data.size / float(data.grid - 1)
	for z in range(data.grid - 1):
		for x in range(data.grid - 1):
			_add_quad(st, data, x, z, half, step)
	st.generate_normals()
	st.generate_tangents()
	_mesh_instance.mesh = st.commit()

	var shader := load("res://shaders/terrain_ground.gdshader") as Shader
	var mat := ShaderMaterial.new()
	mat.shader = shader
	mat.set_shader_parameter("half_world", Vector2(half, half))
	mat.set_shader_parameter("water_y", data.water_y)
	mat.set_shader_parameter("height_min", data.h_min)
	mat.set_shader_parameter("height_span", maxf(data.h_max - data.h_min, 0.001))
	mat.set_shader_parameter("height_tex", ctx.height_tex)
	mat.set_shader_parameter("field_tex", ctx.field_tex)
	_ground_mat = mat
	_mesh_instance.material_override = mat


func _add_quad(st: SurfaceTool, data: MapData, x: int, z: int, half: float, step: float) -> void:
	var corners := [Vector2i(x, z), Vector2i(x + 1, z), Vector2i(x + 1, z + 1), Vector2i(x, z + 1)]
	for oi in [0, 1, 2, 0, 2, 3]:
		var c: Vector2i = corners[oi]
		var wx := -half + float(c.x) * step
		var wz := -half + float(c.y) * step
		var idx := data.idx(c.x, c.y)
		var h := data.heights[idx]
		var b := int(data.biomes[idx])
		st.set_color(_surface_weights(b))
		st.set_uv(Vector2((wx + half) / data.size, (wz + half) / data.size))
		st.add_vertex(Vector3(wx, h, wz))


func _make_field_texture(data: MapData) -> ImageTexture:
	## RGBA8: R=moisture, G=slope, B=cavity, A=lushness (0 forest .. 0.55 grass .. 1 meadow)
	var img := Image.create(data.grid, data.grid, false, Image.FORMAT_RGBA8)
	for z in data.grid:
		for x in data.grid:
			var idx := data.idx(x, z)
			var m := data.moisture[idx] if idx < data.moisture.size() else 0.5
			var s := data.slopes[idx] if idx < data.slopes.size() else 0.0
			var c := data.cavities[idx] if idx < data.cavities.size() else 0.5
			var b := int(data.biomes[idx])
			var lush := 0.55
			if b == MapGen.Biome.MEADOW:
				lush = 1.0
			elif b == MapGen.Biome.FOREST:
				lush = 0.08
			elif b == MapGen.Biome.RIVER or b == MapGen.Biome.LAKE:
				m = 1.0
				c = maxf(c, 0.72)
				lush = 0.45
			img.set_pixel(x, z, Color(clampf(m, 0.0, 1.0), clampf(s, 0.0, 1.0), clampf(c, 0.0, 1.0), lush))
	img.generate_mipmaps()
	return ImageTexture.create_from_image(img)


func _make_height_texture(data: MapData) -> ImageTexture:
	## R channel = normalized height for sea depth/foam sampling.
	## Mipmaps + linear filter keep far shorelines calm (no near/far pop).
	var img := Image.create(data.grid, data.grid, false, Image.FORMAT_RF)
	var span := maxf(data.h_max - data.h_min, 0.001)
	for z in data.grid:
		for x in data.grid:
			var n := (data.heights[data.idx(x, z)] - data.h_min) / span
			img.set_pixel(x, z, Color(n, 0, 0))
	img.generate_mipmaps()
	return ImageTexture.create_from_image(img)


func _build_sea(ctx: TerrainBuildContext) -> void:
	if _water == null:
		return
	var res: Dictionary = SeaMesh.new().build(ctx)
	_water.mesh = res.get("mesh", null) as Mesh
	_water.material_override = res.get("material", null) as Material
	_water.position = res.get("position", Vector3.ZERO) as Vector3
	_water.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF


func _build_lakes(ctx: TerrainBuildContext) -> void:
	if _lakes_mesh == null:
		return
	var res: Dictionary = LakeMesh.new().build(ctx)
	_lakes_mesh.mesh = res.get("mesh", null) as Mesh
	_lakes_mesh.material_override = res.get("material", null) as Material
	_lakes_mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
